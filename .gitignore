# ================================
# MONOREPO ROOT .gitignore
# ================================

# ---- Python / Backend ----
backend/__pycache__/
backend/*.py[cod]
backend/*$py.class
backend/.Python
backend/build/
backend/dist/
backend/*.egg-info/
backend/.eggs/
backend/*.egg
backend/htmlcov/
backend/.tox/
backend/.pytest_cache/
backend/.mypy_cache/
backend/.ruff_cache/
backend/*.mo
backend/*.pot
backend/*.log
backend/local_settings.py
backend/__pypackages__/
backend/.pyre/
backend/.pytype/
backend/cython_debug/

# Python virtual environments (backend)
backend/.env
backend/.venv
backend/env/
backend/venv/
backend/ENV/
backend/env.bak/
backend/venv.bak/

# SQLite databases
backend/*.db
backend/*.sqlite3

# ---- Node.js / Frontend ----
frontend/node_modules/
frontend/dist/
frontend/.env
frontend/.env.local
frontend/.env.*.local

# Vite build artifacts
frontend/.vite/

# ---- Editors & OS ----
.idea/
.vscode/
.DS_Store
Thumbs.db
*.suo
*.ntvs*
*.njsproj
*.sln
*.sw?

venv/
__pycache__
node_modules/